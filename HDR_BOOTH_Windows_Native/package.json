{
  "name": "hdr-booth",
  "version": "0.1.0",
  "description": "HDR BOOTH Professional - Desktop Photo Booth",
  "main": "main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check src/app.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.hdrbooth.desktop",
    "productName": "HDR BOOTH Professional",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "camera/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "HDR-BOOTH-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
